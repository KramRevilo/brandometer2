runtime: python312

instance_class: F4

env_variables:
  RECEIVER_URL: "{{RECEIVER_URL}}"
  PROJECT_ID: "{{PROJECT_ID}}"
  TABLE_ID: "{{PROJECT_ID}}.responses.responses"
  AUTH_USERNAME: "{{AUTH_USERNAME}}"
  AUTH_PASSWORD: "{{AUTH_PASSWORD}}"
  SECRET_KEY: "{{SECRET_KEY}}"
  GTAG_ID: "{{GTAG_ID}}"

handlers:
- url: /favicon\.ico
  static_files: favicon.ico
  upload: favicon\.ico
