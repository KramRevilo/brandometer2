runtime: python312

instance_class: F4

automatic_scaling:
  max_instances: {{MAX_INSTANCES}}

env_variables:
  RECEIVER_URL: "{{RECEIVER_URL}}"
  PROJECT_ID: "{{PROJECT_ID}}"
  TABLE_ID: "{{PROJECT_ID}}.responses.responses"
  GTAG_ID: "{{GTAG_ID}}"
  BOOTSTRAP_ADMIN_EMAIL: "{{BOOTSTRAP_ADMIN_EMAIL}}"
  DATA_STUDIO_TEMPLATE_REPORT_ID: "{{DATA_STUDIO_TEMPLATE_REPORT_ID}}"
  DATA_STUDIO_TEMPLATE_DS_ALIAS: "{{DATA_STUDIO_TEMPLATE_DS_ALIAS}}"

handlers:
- url: /favicon\.ico
  static_files: favicon.ico
  upload: favicon\.ico
  secure: always
- url: /static
  static_dir: static
  secure: always
- url: /.*
  script: auto
  secure: always
