#!/bin/sh

# Fail on any error
set -e

APP_ONLY=0
SKIP_OAUTH_PROMPTS=0
POSITIONAL=""
for arg in "$@"; do
    case "$arg" in
        --app-only) APP_ONLY=1 ;;
        --skip-oauth-prompts) SKIP_OAUTH_PROMPTS=1 ;;
        --help|-h)
            echo "Usage: ./deploy project-id zone app_region [--app-only] [--skip-oauth-prompts]"
            echo "Example: ./deploy my-project-id us-central1 us-central"
            echo "App Engine only (receiver already deployed):"
            echo "  ./deploy my-project-id us-central1 us-central --app-only"
            echo "Non-interactive OAuth (env vars; Enter is not needed):"
            echo "  OAUTH_CLIENT_ID=... OAUTH_CLIENT_SECRET=... BOOTSTRAP_ADMIN_EMAIL=... \\"
            echo "    ./deploy my-project-id us-central1 us-central --app-only --skip-oauth-prompts"
            echo "Existing OAuth secrets: omit the env vars and pass --skip-oauth-prompts to keep them."
            exit 0
            ;;
        --*)
            echo "Unknown flag: $arg" >&2
            echo "Usage: ./deploy project-id zone app_region [--app-only] [--skip-oauth-prompts]" >&2
            exit 1
            ;;
        *)
            POSITIONAL="$POSITIONAL $arg"
            ;;
    esac
done
# shellcheck disable=SC2086
set -- $POSITIONAL

PROJECT_ID=$1
LOCATION=$2
REGION=$3

if [ -z "$PROJECT_ID" ] || [ -z "$LOCATION" ] || [ -z "$REGION" ]; then
    # To list possible values for:
    #   LOCATION: $ gcloud functions regions list
    #   REGION: $  gcloud app regions list
    echo "Usage: ./deploy project-id zone app_region [--app-only] [--skip-oauth-prompts]"
    echo "Example: ./deploy my-project-id us-central1 us-central"
    echo "App Engine only: ./deploy my-project-id us-central1 us-central --app-only"
    exit 1
fi

DEPLOY_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$DEPLOY_ROOT"

MAX_INSTANCES="${MAX_INSTANCES:-5}"
case "$MAX_INSTANCES" in
    ''|*[!0-9]*)
        echo "ERROR: MAX_INSTANCES must be a positive integer (got $MAX_INSTANCES)" >&2
        exit 1
        ;;
esac
if [ "$MAX_INSTANCES" -lt 1 ]; then
    echo "ERROR: MAX_INSTANCES must be >= 1" >&2
    exit 1
fi

# IAM can lag a newly created service account ("does not exist") for a bit.
# Override in tests. Production waits up to ~2 minutes with exponential backoff.
RETRY_MAX_SECONDS="${DEPLOY_RETRY_MAX_SECONDS:-120}"
RETRY_START_SECONDS="${DEPLOY_RETRY_START_SECONDS:-2}"
RETRY_MAX_DELAY_SECONDS="${DEPLOY_RETRY_MAX_DELAY_SECONDS:-16}"

# Retry SA-lag / concurrent policy errors only. Never retry usage errors.
retry_is_transient() {
    msg=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$msg" in
        *'invalid choice'*|*'unknown command'*|*'unrecognized arguments'*|*'unrecognized flag'*|*'too few arguments'*|*'too many arguments'*|*permission_denied*|*'permission denied'*|*'access denied'*|*'httperror 403'*|*'status: 403'*)
            return 1
            ;;
    esac
    case "$msg" in
        *'does not exist'*|*not_found*|*notfound*|*invalid_argument*|*'http 409'*|*'status: 409'*|*aborted*|*concurrent*|*etag*|*resource_exhausted*|*unavailable*|*'rate limit'*|*'429'*|*backenderror*)
            return 0
            ;;
    esac
    return 1
}

retry_gcloud() {
    delay="$RETRY_START_SECONDS"
    elapsed=0
    while true; do
        errfile=$(mktemp)
        status=0
        "$@" >"$errfile" 2>&1 || status=$?
        if [ "$status" -eq 0 ]; then
            rm -f "$errfile"
            return 0
        fi
        out=$(cat "$errfile")
        cat "$errfile" >&2
        rm -f "$errfile"
        if ! retry_is_transient "$out"; then
            echo "ERROR: not retrying (non-transient): $*" >&2
            return "$status"
        fi
        if [ "$elapsed" -ge "$RETRY_MAX_SECONDS" ]; then
            echo "ERROR: still failing after ${RETRY_MAX_SECONDS}s: $*" >&2
            return 1
        fi
        echo "Retrying in ${delay}s (waited ${elapsed}s / ${RETRY_MAX_SECONDS}s): $*" >&2
        sleep "$delay"
        elapsed=$((elapsed + delay))
        delay=$((delay * 2))
        if [ "$delay" -gt "$RETRY_MAX_DELAY_SECONDS" ]; then
            delay="$RETRY_MAX_DELAY_SECONDS"
        fi
    done
}

wait_for_service_account() {
    email="$1"
    echo "Waiting until IAM can see $email"
    retry_gcloud gcloud iam service-accounts describe "$email" \
        --format='value(email)' >/dev/null
}

ensure_receiver_sa() {
    if gcloud iam service-accounts describe "$RECEIVER_SA" >/dev/null 2>&1; then
        echo "Service account $RECEIVER_SA already exists"
    else
        gcloud iam service-accounts create brandometer-receiver \
            --display-name="Brandometer response receiver"
    fi
    wait_for_service_account "$RECEIVER_SA"
}

grant_project_role() {
    member="$1"
    role="$2"
    retry_gcloud gcloud projects add-iam-policy-binding "$PROJECT_ID" \
        --member="$member" \
        --role="$role" \
        --condition=None >/dev/null
}

# Bucket-level objectAdmin for App Engine Cloud Build staging. Skip if the
# bucket has not been created yet (first deploy may create it).
grant_bucket_object_admin() {
    bucket="$1"
    member="$2"
    if gcloud storage buckets describe "$bucket" >/dev/null 2>&1; then
        echo "Granting roles/storage.objectAdmin on $bucket to $member"
        retry_gcloud gcloud storage buckets add-iam-policy-binding "$bucket" \
            --member="$member" \
            --role="roles/storage.objectAdmin" \
            --condition=None >/dev/null
    else
        echo "Bucket $bucket does not exist (skipping IAM)"
    fi
}

# App Engine standard Cloud Build runs as the default GAE SA. These replace
# roles/editor for gcloud app deploy (staging bucket + Artifact Registry).
grant_gae_build_roles() {
    member="serviceAccount:$GAE_SA"
    echo "Granting App Engine Cloud Build roles to $GAE_SA"
    grant_project_role "$member" "roles/cloudbuild.builds.builder"
    grant_project_role "$member" "roles/artifactregistry.createOnPushWriter"
    grant_bucket_object_admin "gs://staging.${PROJECT_ID}.appspot.com" "$member"
    grant_bucket_object_admin "gs://${PROJECT_ID}.appspot.com" "$member"
}

dataset_member_email() {
    email="$1"
    case "$email" in
        serviceAccount:*) email="${email#serviceAccount:}" ;;
        user:*) email="${email#user:}" ;;
        group:*) email="${email#group:}" ;;
    esac
    printf '%s' "$email"
}

# Dataset IAM via the legacy access[] resource. The IAM-binding bq subcommand
# requires allowlisting and is not used. Write `bq show` to a file (never a
# pipe): warnings on stdout used to JSONDecodeError / BrokenPipe.
BQ_DATASET_IAM_PY="$DEPLOY_ROOT/creative/app/bq_dataset_iam.py"
REPORTING_VIEWS_PY="$DEPLOY_ROOT/creative/app/reporting_views.py"
REPORTING_DATASET="brandometer_reporting"
RESPONSES_DATASET_DESCRIPTION="Main response dataset for Brandometer2"
REPORTING_DATASET_DESCRIPTION="Authorized Brandometer2 reporting views for Looker Studio (no raw responses table)"
RESPONSES_TABLE_DESCRIPTION="Survey response rows for Brandometer2"

update_bq_description() {
    resource="$1"
    desc="$2"
    if ! bq show --format=none "$resource" >/dev/null 2>&1; then
        echo "Skip description update; $resource does not exist"
        return 0
    fi
    echo "Updating description on $resource"
    bq update --description "$desc" "$resource"
}

ensure_dataset_descriptions() {
    echo -e "\n-- Update BigQuery dataset descriptions (existing datasets too)"
    update_bq_description "$PROJECT_ID:responses" "$RESPONSES_DATASET_DESCRIPTION"
    update_bq_description "$PROJECT_ID:$REPORTING_DATASET" "$REPORTING_DATASET_DESCRIPTION"
    if bq show --format=none "$PROJECT_ID:responses.responses" >/dev/null 2>&1; then
        update_bq_description "$PROJECT_ID:responses.responses" "$RESPONSES_TABLE_DESCRIPTION"
    fi
}

PARTITION_MIGRATE_PY="$DEPLOY_ROOT/tools/migrate_responses_partition.py"

warn_if_unpartitioned() {
    echo -e "\n-- Check responses table partitioning"
    set +e
    python3 "$PARTITION_MIGRATE_PY" --project "$PROJECT_ID" --check
    status=$?
    set -e
    if [ "$status" -eq 0 ]; then
        echo "Table $PROJECT_ID:responses.responses is DAY-partitioned on CreatedAt"
        return 0
    fi
    if [ "$status" -eq 3 ]; then
        echo "Table $PROJECT_ID:responses.responses is missing (new deploys create it partitioned)"
        return 0
    fi
    echo "WARNING: $PROJECT_ID:responses.responses is not DAY-partitioned on CreatedAt."
    echo "Deploy will not drop or recreate it. Migrate with:"
    echo "  python3 tools/migrate_responses_partition.py --project $PROJECT_ID"
    echo "  python3 tools/migrate_responses_partition.py --project $PROJECT_ID --apply"
    return 0
}

show_dataset_json() {
    dest="$1"
    dataset_id="${2:-responses}"
    PYTHONWARNINGS=ignore bq --format=prettyjson --quiet show --dataset \
        "$PROJECT_ID:$dataset_id" >"$dest" 2>/dev/null
}

remove_project_role() {
    member="$1"
    role="$2"
    errfile=$(mktemp)
    status=0
    gcloud projects remove-iam-policy-binding "$PROJECT_ID" \
        --member="$member" \
        --role="$role" \
        --condition=None >"$errfile" 2>&1 || status=$?
    out=$(cat "$errfile")
    rm -f "$errfile"
    if [ "$status" -eq 0 ]; then
        echo "Removed project $role from $member"
        return 0
    fi
    lowered=$(printf '%s' "$out" | tr '[:upper:]' '[:lower:]')
    case "$lowered" in
        *'not found'*|*not_found*|*'does not exist'*)
            echo "No project $role on $member (ok)"
            return 0
            ;;
    esac
    if retry_is_transient "$out"; then
        retry_gcloud gcloud projects remove-iam-policy-binding "$PROJECT_ID" \
            --member="$member" \
            --role="$role" \
            --condition=None >/dev/null
        echo "Removed project $role from $member"
        return 0
    fi
    printf '%s\n' "$out" >&2
    return "$status"
}

grant_dataset_editor_via_update() {
    member="$1"
    email=$(dataset_member_email "$member")
    tmp=$(mktemp)
    if ! show_dataset_json "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    py_status=0
    python3 "$BQ_DATASET_IAM_PY" merge "$tmp" "$email" || py_status=$?
    if [ "$py_status" -eq 0 ]; then
        rm -f "$tmp"
        return 0
    fi
    if [ "$py_status" -ne 2 ]; then
        rm -f "$tmp"
        return 1
    fi
    if retry_gcloud env PYTHONWARNINGS=ignore bq --quiet update --source "$tmp" \
            "$PROJECT_ID:responses"; then
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

verify_dataset_editor() {
    member="$1"
    email=$(dataset_member_email "$member")
    dataset="$PROJECT_ID:responses"
    tmp=$(mktemp)
    if ! show_dataset_json "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    role=$(python3 "$BQ_DATASET_IAM_PY" verify "$tmp" "$email") || true
    rm -f "$tmp"
    if [ -n "$role" ]; then
        echo "Dataset IAM confirmed: $email has $role on $dataset"
        return 0
    fi
    echo "ERROR: $email is not a dataEditor/WRITER on $dataset" >&2
    return 1
}

grant_dataset_editor() {
    member="$1"
    dataset="$PROJECT_ID:responses"
    echo "Granting dataset WRITER on $dataset to $member via bq update --source"
    if grant_dataset_editor_via_update "$member" && verify_dataset_editor "$member"; then
        echo "Removing project roles/bigquery.dataEditor from $member (dataset IAM is enough)"
        if ! remove_project_role "$member" "roles/bigquery.dataEditor"; then
            echo "WARNING: could not remove project roles/bigquery.dataEditor from $member"
        fi
        return 0
    fi
    echo "Dataset IAM unavailable; granting project roles/bigquery.dataEditor to $member"
    grant_project_role "$member" "roles/bigquery.dataEditor"
}

ensure_respondent_columns() {
    table="$PROJECT_ID:responses.responses"
    if ! bq show --format=none "$table" >/dev/null 2>&1; then
        echo "Table $table missing; skip RespondentID columns"
        return 0
    fi
    echo "-- Add NULLABLE RespondentID columns on $table (idempotent)"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS RespondentID STRING"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS RespondentIDSource STRING"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS CampaignID STRING"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS PlacementID STRING"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS SiteID STRING"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS AdCreativeID STRING"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "ALTER TABLE \`$PROJECT_ID.responses.responses\` ADD COLUMN IF NOT EXISTS CreativeVersion INT64"
}

authorize_reporting_views() {
    tmp=$(mktemp)
    if ! show_dataset_json "$tmp" responses; then
        rm -f "$tmp"
        echo "WARNING: could not load $PROJECT_ID:responses ACL; skip authorizing reporting views"
        return 0
    fi
    py_status=0
    python3 "$BQ_DATASET_IAM_PY" authorize-dataset "$tmp" "$PROJECT_ID" \
        "$REPORTING_DATASET" || py_status=$?
    if [ "$py_status" -eq 0 ]; then
        echo "Reporting dataset already authorized on responses"
        rm -f "$tmp"
        return 0
    fi
    if [ "$py_status" -ne 2 ]; then
        rm -f "$tmp"
        echo "WARNING: could not merge reporting authorized dataset"
        return 0
    fi
    if retry_gcloud env PYTHONWARNINGS=ignore bq --quiet update --source "$tmp" \
            "$PROJECT_ID:responses"; then
        echo "Authorized $PROJECT_ID:$REPORTING_DATASET views on responses"
        rm -f "$tmp"
        return 0
    fi
    echo "WARNING: bq update failed while authorizing reporting views"
    rm -f "$tmp"
    return 0
}

ensure_reporting_dataset() {
    table="$PROJECT_ID:responses.responses"
    if ! bq show --format=none "$table" >/dev/null 2>&1; then
        echo "Table $table missing; skip reporting dataset"
        return 0
    fi
    dataset="$PROJECT_ID:$REPORTING_DATASET"
    if bq show --format=none "$dataset" >/dev/null 2>&1; then
        echo "Dataset $dataset already exists (not modified)"
    else
        bq --location=$LOCATION mk \
            --dataset \
            --description "$REPORTING_DATASET_DESCRIPTION" \
            "$dataset"
    fi
    echo "-- Create authorized reporting views on $dataset"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "$(python3 "$REPORTING_VIEWS_PY" deduped "$PROJECT_ID")"
    bq query --use_legacy_sql=false --project_id="$PROJECT_ID" --nouse_cache --quiet \
        "$(python3 "$REPORTING_VIEWS_PY" summary "$PROJECT_ID")"
    authorize_reporting_views
}

grant_sa_user() {
    sa_email="$1"
    member="$2"
    retry_gcloud gcloud iam service-accounts add-iam-policy-binding "$sa_email" \
        --member="$member" \
        --role="roles/iam.serviceAccountUser" \
        --condition=None >/dev/null
}

secret_exists() {
    gcloud secrets describe "$1" >/dev/null 2>&1
}

bootstrap_from_yaml() {
    yaml="creative/app/${PROJECT_ID}.yaml"
    if [ ! -f "$yaml" ]; then
        return 1
    fi
    python3 - "$yaml" <<'PY'
import re
import sys

text = open(sys.argv[1], encoding='utf-8').read()
match = re.search(r'^  BOOTSTRAP_ADMIN_EMAIL:\s*(.*)$', text, re.M)
if not match:
    sys.exit(1)
print(match.group(1).strip().strip('"').strip("'"))
PY
}

# Prints the value on stdout when a new value should be stored; prints nothing
# when the existing Secret Manager value should be kept.
prompt_secret_input() {
    name="$1"
    prompt="$2"
    silent="$3"
    env_value="$4"
    exists=0
    if secret_exists "$name"; then
        exists=1
    fi
    value="$env_value"
    if [ "$SKIP_OAUTH_PROMPTS" = 1 ]; then
        if [ -n "$value" ]; then
            echo "Using $name from environment" >&2
        elif [ "$exists" = 1 ]; then
            echo "Keeping existing secret $name (--skip-oauth-prompts)" >&2
            return 0
        else
            echo "ERROR: $name does not exist; set the env var or omit --skip-oauth-prompts" >&2
            return 1
        fi
    elif [ -z "$value" ]; then
        extra=""
        if [ "$exists" = 1 ]; then
            extra=" [press Enter to keep existing]"
        fi
        if [ "$silent" = 1 ]; then
            # read -p/-s is what Cloud Shell bash provides (existing deploy).
            read -sp "${prompt}${extra}: " value
            echo >&2
        else
            read -p "${prompt}${extra}: " value
        fi
    else
        echo "Using $name from environment" >&2
    fi
    if [ -z "$value" ]; then
        if [ "$exists" = 1 ]; then
            echo "Keeping existing secret $name" >&2
            return 0
        fi
        echo "ERROR: $prompt is required" >&2
        return 1
    fi
    printf '%s' "$value"
}

# Set gcloud to project id
echo -e "\n-- Deploying to $PROJECT_ID"
if [ "$APP_ONLY" = 1 ]; then
    echo "Mode: --app-only (skip receiver / dataset / functions)"
fi
gcloud config set project $PROJECT_ID

GAE_SA="$PROJECT_ID@appspot.gserviceaccount.com"
RECEIVER_SA="brandometer-receiver@$PROJECT_ID.iam.gserviceaccount.com"

if [ "$APP_ONLY" != 1 ]; then
    echo -e "\n-- Enable required APIs"
    gcloud services enable cloudbuild.googleapis.com
    gcloud services enable firestore.googleapis.com
    gcloud services enable appengine.googleapis.com
    gcloud services enable cloudfunctions.googleapis.com
    gcloud services enable bigquery.googleapis.com
    gcloud services enable run.googleapis.com
    gcloud services enable artifactregistry.googleapis.com
    gcloud services enable secretmanager.googleapis.com
    gcloud services enable iam.googleapis.com

    # Create Firestore Native before App Engine. `gcloud app create` otherwise
    # provisions (default) in Datastore mode, which the Firestore client cannot use.
    echo -e "\n-- Create Firestore Native (default) database"
    DB_TYPE=$(gcloud firestore databases describe --database='(default)' --format='value(type)' 2>/dev/null || true)
    if [ -z "$DB_TYPE" ]; then
        gcloud firestore databases create \
            --location="$LOCATION" \
            --type=firestore-native \
            --database='(default)'
    elif echo "$DB_TYPE" | grep -qi 'FIRESTORE_NATIVE'; then
        echo "Firestore Native database (default) already exists"
    elif echo "$DB_TYPE" | grep -qi 'DATASTORE'; then
        echo "ERROR: Cloud Firestore API is not available because (default) is in Datastore mode ($DB_TYPE)."
        echo "Brandometer2 needs Firestore Native. If that database is empty, switch it with:"
        echo "  gcloud firestore databases delete --database='(default)'"
        echo "  gcloud firestore databases create --location=$LOCATION --type=firestore-native --database='(default)'"
        echo "See DEVELOPERS.md (Firestore Datastore mode)."
        exit 1
    else
        echo "ERROR: unexpected type for Firestore database (default): $DB_TYPE"
        echo "Brandometer2 needs --type=firestore-native."
        exit 1
    fi

    echo -e "\n-- Create BigQuery dataset"
    # `bq mk --dataset --force` does not drop an existing dataset (it only ignores
    # ALREADY_EXISTS) but it still prints "successfully created". Skip if present
    # so a re-run never looks like a recreate and never changes location/tables.
    if bq show --format=none "$PROJECT_ID:responses" >/dev/null 2>&1; then
        echo "Dataset $PROJECT_ID:responses already exists (not modified)"
    else
        bq --location=$LOCATION mk \
            --dataset \
            --description "$RESPONSES_DATASET_DESCRIPTION" \
            $PROJECT_ID:responses
    fi

    echo -e "\n-- Create BigQuery responses table"
    if bq show --format=none "$PROJECT_ID:responses.responses" >/dev/null 2>&1; then
        echo "Table $PROJECT_ID:responses.responses already exists (not recreated)"
    else
        # Partition by CreatedAt (DAY) and cluster by ID for new tables.
        # Existing unpartitioned tables are left in place; warn_if_unpartitioned
        # prints the migrate_responses_partition.py command.
        bq mk --table \
            --schema receiver/responses.schema.json \
            --time_partitioning_field CreatedAt \
            --time_partitioning_type DAY \
            --clustering_fields ID \
            --description "$RESPONSES_TABLE_DESCRIPTION" \
            "$PROJECT_ID:responses.responses"
    fi

    PROJECT_NUMBER=$(gcloud projects describe "$PROJECT_ID" --format='value(projectNumber)')

    echo -e "\n-- Receiver service account (least privilege)"
    ensure_receiver_sa

    grant_project_role "serviceAccount:$RECEIVER_SA" "roles/datastore.viewer"
    grant_project_role "serviceAccount:$RECEIVER_SA" "roles/logging.logWriter"

    # Deployer + Cloud Functions/Run agents must be able to attach the runtime SA.
    DEPLOYER=$(gcloud config get-value account 2>/dev/null || true)
    if [ -n "$DEPLOYER" ]; then
        case "$DEPLOYER" in
            *.gserviceaccount.com) DEPLOYER_MEMBER="serviceAccount:$DEPLOYER" ;;
            *) DEPLOYER_MEMBER="user:$DEPLOYER" ;;
        esac
        if ! grant_sa_user "$RECEIVER_SA" "$DEPLOYER_MEMBER"; then
            echo "WARNING: could not grant roles/iam.serviceAccountUser on $RECEIVER_SA to $DEPLOYER_MEMBER"
        fi
    fi
    if [ -n "$PROJECT_NUMBER" ]; then
        grant_sa_user "$RECEIVER_SA" \
            "serviceAccount:service-${PROJECT_NUMBER}@gcf-admin-robot.iam.gserviceaccount.com"
        grant_sa_user "$RECEIVER_SA" \
            "serviceAccount:service-${PROJECT_NUMBER}@serverless-robot-prod.iam.gserviceaccount.com"
    fi
fi

echo -e "\n-- HMAC secrets (receiver tokens + daily IP hashes)"
bind_secret_member() {
    name="$1"
    member="$2"
    if [ -z "$member" ]; then
        return 0
    fi
    retry_gcloud gcloud secrets add-iam-policy-binding "$name" \
        --member="$member" \
        --role="roles/secretmanager.secretAccessor" \
        --condition=None >/dev/null
}

# Generated secrets: create once. Rotating them would invalidate live zips / sessions.
ensure_generated_secret() {
    name="$1"
    extra_member="$2"
    if gcloud secrets describe "$name" >/dev/null 2>&1; then
        echo "Keeping existing secret $name"
    else
        value=$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')
        printf '%s' "$value" | gcloud secrets create "$name" \
            --data-file=- \
            --replication-policy=automatic >/dev/null
        echo "stored ${#value} chars ($name)"
    fi
    bind_secret_member "$name" "$extra_member"
}

upsert_secret() {
    name="$1"
    value="$2"
    extra_member="$3"
    if [ -z "$value" ]; then
        echo "Keeping existing secret $name"
        bind_secret_member "$name" "serviceAccount:$GAE_SA"
        bind_secret_member "$name" "$extra_member"
        return 0
    fi
    if gcloud secrets describe "$name" >/dev/null 2>&1; then
        printf '%s' "$value" | gcloud secrets versions add "$name" --data-file=- >/dev/null
    else
        printf '%s' "$value" | gcloud secrets create "$name" \
            --data-file=- \
            --replication-policy=automatic >/dev/null
    fi
    echo "stored ${#value} chars ($name)"
    bind_secret_member "$name" "serviceAccount:$GAE_SA"
    bind_secret_member "$name" "$extra_member"
}

ensure_generated_secret brandometer-receiver-hmac "serviceAccount:$RECEIVER_SA"
ensure_generated_secret brandometer-ip-hmac "serviceAccount:$RECEIVER_SA"

if [ "$APP_ONLY" != 1 ]; then
    echo -e "\n-- Deploy Cloud Function for receiver (2nd gen)"
    gcloud functions deploy receiver \
        --gen2 \
        --trigger-http \
        --allow-unauthenticated \
        --runtime python312 \
        --entry-point=receiver \
        --region=$LOCATION \
        --source=receiver \
        --service-account="$RECEIVER_SA" \
        --max-instances=20 \
        --timeout=60s \
        --memory=256MB \
        --set-env-vars TABLE_ID=$PROJECT_ID.responses.responses \
        --set-secrets RECEIVER_HMAC_SECRET=brandometer-receiver-hmac:latest,IP_HMAC_SECRET=brandometer-ip-hmac:latest
fi

echo -e "\n-- Read deployed receiver URL"
RECEIVER_URL=$(gcloud functions describe receiver \
    --gen2 \
    --region=$LOCATION \
    --format='value(serviceConfig.uri)')
if [ -z "$RECEIVER_URL" ]; then
    RECEIVER_URL=$(gcloud functions describe receiver \
        --gen2 \
        --region=$LOCATION \
        --format='value(url)')
fi
if [ -z "$RECEIVER_URL" ]; then
    echo "ERROR: could not determine the receiver function URL."
    exit 1
fi
case "$RECEIVER_URL" in
    https://*) ;;
    *)
        echo "ERROR: RECEIVER_URL must be https:// (got: $RECEIVER_URL)" >&2
        exit 1
        ;;
esac
echo "Receiver URL: $RECEIVER_URL"

echo -e "\nSet up App Engine (if none exists)"
if gcloud app services list; then
    echo "App Engine already configured. Continuing..."
else
    gcloud app create --region=$REGION
fi

echo -e "\n-- App Engine service account (least privilege; replaces roles/editor)"
wait_for_service_account "$GAE_SA"
grant_project_role "serviceAccount:$GAE_SA" "roles/datastore.user"
grant_project_role "serviceAccount:$GAE_SA" "roles/bigquery.jobUser"
grant_project_role "serviceAccount:$GAE_SA" "roles/logging.logWriter"
grant_project_role "serviceAccount:$GAE_SA" "roles/secretmanager.secretAccessor"
grant_gae_build_roles
# Dataset IAM for both SAs also on --app-only (last run fell back to project
# dataEditor after bq show stdout was polluted with Python warnings).
grant_dataset_editor "serviceAccount:$RECEIVER_SA"
grant_dataset_editor "serviceAccount:$GAE_SA"
ensure_respondent_columns
ensure_reporting_dataset
ensure_dataset_descriptions
warn_if_unpartitioned
# HMAC secrets were created before App Engine existed; bind GAE now.
bind_secret_member brandometer-receiver-hmac "serviceAccount:$GAE_SA"
if gcloud projects remove-iam-policy-binding "$PROJECT_ID" \
        --member="serviceAccount:$GAE_SA" \
        --role="roles/editor" \
        --condition=None >/dev/null 2>&1; then
    echo "Removed roles/editor from $GAE_SA"
else
    echo "roles/editor was not bound to $GAE_SA (ok)"
fi

echo -e "\n-- Google Sign-In (OAuth client id/secret) and first admin"
echo "Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console:"
echo "  APIs & Services → Credentials → Create credentials → OAuth client ID"
echo "Authorized redirect URIs to add:"
echo "  https://$PROJECT_ID.appspot.com/auth/callback"
echo "  https://$PROJECT_ID.uc.r.appspot.com/auth/callback"
echo "  http://127.0.0.1:8080/auth/callback"
echo "  http://localhost:8080/auth/callback"
echo "Cloud Shell Web Preview (port 8080) uses a per-session host. After opening"
echo "Web Preview, add that origin + /auth/callback, for example:"
echo "  https://8080-<session>.cs-<region>.cloudshell.dev/auth/callback"
echo "  https://8080-dot-<vm>-dot-devshell.appspot.com/auth/callback"
echo "Or skip OAuth in Shell and set DISABLE_BASIC_AUTH=1 (refused on App Engine)."
echo "Env vars: OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET, BOOTSTRAP_ADMIN_EMAIL."
echo "Flag: --skip-oauth-prompts keeps existing secrets when those env vars are empty."

OAUTH_ID_VALUE=$(prompt_secret_input \
    brandometer-oauth-client-id \
    "OAuth client ID" \
    0 \
    "${OAUTH_CLIENT_ID:-}")
OAUTH_SECRET_VALUE=$(prompt_secret_input \
    brandometer-oauth-client-secret \
    "OAuth client secret" \
    1 \
    "${OAUTH_CLIENT_SECRET:-}")

BOOTSTRAP_ADMIN_EMAIL="${BOOTSTRAP_ADMIN_EMAIL:-}"
if [ "$SKIP_OAUTH_PROMPTS" = 1 ]; then
    if [ -z "$BOOTSTRAP_ADMIN_EMAIL" ]; then
        BOOTSTRAP_ADMIN_EMAIL=$(bootstrap_from_yaml || true)
    fi
    if [ -z "$BOOTSTRAP_ADMIN_EMAIL" ]; then
        echo "ERROR: BOOTSTRAP_ADMIN_EMAIL is required (env or existing yaml) with --skip-oauth-prompts" >&2
        exit 1
    fi
    echo "Using bootstrap admin $BOOTSTRAP_ADMIN_EMAIL"
elif [ -n "$BOOTSTRAP_ADMIN_EMAIL" ]; then
    echo "Using BOOTSTRAP_ADMIN_EMAIL from environment"
else
    existing_bootstrap=$(bootstrap_from_yaml || true)
    extra=""
    if [ -n "$existing_bootstrap" ]; then
        extra=" [press Enter to keep existing]"
    fi
    read -p "Bootstrap admin email${extra}: " BOOTSTRAP_ADMIN_EMAIL
    if [ -z "$BOOTSTRAP_ADMIN_EMAIL" ]; then
        BOOTSTRAP_ADMIN_EMAIL="$existing_bootstrap"
    fi
fi
if [ -z "$BOOTSTRAP_ADMIN_EMAIL" ]; then
    echo "ERROR: bootstrap admin email is required"
    exit 1
fi
echo "-- Bootstrap admin: $BOOTSTRAP_ADMIN_EMAIL"

ensure_generated_secret brandometer-secret-key
bind_secret_member brandometer-secret-key "serviceAccount:$GAE_SA"
upsert_secret brandometer-oauth-client-id "$OAUTH_ID_VALUE"
upsert_secret brandometer-oauth-client-secret "$OAUTH_SECRET_VALUE"
# Optional Google tag (gtag.js) ID for creatives. Empty disables the loader.
GTAG_ID="${GTAG_ID:-}"
# Optional Looker Studio template (Linking API c.reportId + data-source alias).
LOOKER_TEMPLATE_REPORT_ID="${LOOKER_TEMPLATE_REPORT_ID:-}"
LOOKER_TEMPLATE_DS_ALIAS="${LOOKER_TEMPLATE_DS_ALIAS:-}"

echo -e "\n-- Set up app engine config"
sed \
    -e "s|{{RECEIVER_URL}}|$RECEIVER_URL|" \
    -e "s|{{PROJECT_ID}}|$PROJECT_ID|" \
    -e "s|{{GTAG_ID}}|$GTAG_ID|" \
    -e "s|{{BOOTSTRAP_ADMIN_EMAIL}}|$BOOTSTRAP_ADMIN_EMAIL|" \
    -e "s|{{MAX_INSTANCES}}|$MAX_INSTANCES|" \
    -e "s|{{LOOKER_TEMPLATE_REPORT_ID}}|$LOOKER_TEMPLATE_REPORT_ID|" \
    -e "s|{{LOOKER_TEMPLATE_DS_ALIAS}}|$LOOKER_TEMPLATE_DS_ALIAS|" \
    creative/app/app.yaml.template >./creative/app/$PROJECT_ID.yaml
python3 creative/app/app_yaml_check.py "./creative/app/$PROJECT_ID.yaml"
echo -e "\n-- Deploy app engine"

cd creative/app
if ! gcloud app deploy ./$PROJECT_ID.yaml --quiet; then
    echo -e "\n-- ERROR: App Engine deployment failed. This is usually caused by a delay in project config rollout."
    echo -e "Please wait 1-2 minutes and run:"
    echo -e "\t./deploy $PROJECT_ID $LOCATION $REGION --app-only"
    echo -e "Or: cd creative/app && gcloud app deploy ./$PROJECT_ID.yaml --quiet"
    exit 1
fi
